### ===== 본인에 맞는 데이터를 집어 넣고 파일명을 .env로 변경 후 사용하세요

# db
DB_HOST=디비 주소
DB_USER=로그인 아이디
DB_PASSWORD=패스워드
DB_NAME=디비명

# kis api 호출용 데이터
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_URL=
KIS_USER_ID=

# 네이버 api 호출용 데이터
NAVER_CLIENT_KEY=
NAVER_SECRET_KEY=

# 저장된 뉴스 데이터에서 metadata 뽑아내기 위한 ollama
OLLAMA_MODEL=
OLLAMA_URL=